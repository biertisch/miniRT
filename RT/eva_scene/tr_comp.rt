# Camera
C 0,0,-5   0,0,1   60
# Light
L 5,5,5   1.0   255,255,255

A 0.2 255,255,255
# Colors
# Red: front, Green: back, Blue: left, Yellow: right, Magenta: top, Cyan: bottom

pl 0,-2,0 0,1,0 200,200,200  # Ground plane
# -------------------
# 3D "42" Sculpture (centered at origin)
# "4" (triangles, orange)
tr -2,0,0   -1,0,0   -1,2,0   255,165,0
tr -2,0,0   -1,2,0   -2,2,0   255,165,0
tr -1.5,1,0  -0.5,1,0  -0.5,2,0  255,165,0
tr -1.5,1,0  -0.5,2,0  -1.5,2,0  255,165,0

# "2" (triangles, blue)
tr 0,0,0   2,0,0   2,1,0   0,0,255
tr 0,0,0   2,1,0   0,1,0   0,0,255
tr 0,1,0   2,1,0   2,2,0   0,0,255
tr 0,1,0   2,2,0   0,2,0   0,0,255
tr 0,2,0   2,2,0   2,3,0   0,0,255
tr 0,2,0   2,3,0   0,3,0   0,0,255

# -------------------
# Arch Bridge (shifted -5 in x, far z = -5)
tr -2,0,-5   2,0,-5   1,1,-5   150,150,150
tr -2,0,-5   1,1,-5   -1,1,-5   150,150,150
tr -2,0,-5   -1,1,-5   -1,0,-5   150,150,150
tr 2,0,-5   1,1,-5   2,1,-5    150,150,150
tr -1,0,-5   1,0,-5   0,1,-5    200,100,50
tr -1,0,-5   0,1,-5   -0.5,1,-5 200,100,50
tr 1,0,-5   2,0,-5   1.5,1,-5   200,100,50
tr 1,0,-5   1.5,1,-5  0,1,-5    200,100,50

# -------------------
# Low-poly Sphere (center 0,5,0, radius 1, 8 lat 16 lon simplified)
tr -0.0,6,0   0.7,5.7,0.7   -0.7,5.7,0.7   200,200,200
tr -0.0,6,0   0.7,5.7,0.7   0.7,5.7,-0.7  200,200,200
tr -0.0,6,0   0.7,5.7,-0.7  -0.7,5.7,-0.7 200,200,200
tr -0.0,6,0   -0.7,5.7,-0.7 -0.7,5.7,0.7  200,200,200
tr -0.0,4,0   0.7,4.3,0.7   -0.7,4.3,0.7  220,220,220
tr -0.0,4,0   0.7,4.3,0.7   0.7,4.3,-0.7 220,220,220
tr -0.0,4,0   0.7,4.3,-0.7 -0.7,4.3,-0.7 220,220,220
tr -0.0,4,0   -0.7,4.3,-0.7 -0.7,4.3,0.7 220,220,220
tr 0.7,5.7,0.7 0.7,4.3,0.7 0.7,4.3,-0.7 210,210,210
tr 0.7,5.7,0.7 0.7,4.3,-0.7 0.7,5.7,-0.7 210,210,210
tr -0.7,5.7,0.7 -0.7,4.3,0.7 -0.7,4.3,-0.7 210,210,210
tr -0.7,5.7,0.7 -0.7,4.3,-0.7 -0.7,5.7,-0.7 210,210,210