# Camera
C 0,0,-5   0,0,1   60
# Light
L 5,5,5   1.0   255,255,255

A 0.2 255,255,255
# Body (green, low-poly ellipsoid simplified by 4 triangles)
tr -1,0,0   1,0,0   0,0.5,1   0,200,0
tr -1,0,0   0,0.5,1   -0.5,0,1  0,200,0
tr 1,0,0    0,0.5,1   0.5,0,1   0,200,0
tr -0.5,0,1 0,0.5,1   0.5,0,1   0,200,0

# Head (yellow, low-poly)
tr 0.5,0,1   0.8,0,1.2   0.5,0.3,1.2   255,255,0
tr 0.5,0,1   0.5,0.3,1.2 0.2,0,1.2   255,255,0

# Tail (orange, low-poly)
tr -1,0,0   -1,-0.2,0   -1.5,0,0.5   255,165,0
tr -1,-0.2,0   -1.5,0,0.5   -1.5,-0.2,0.5 255,165,0

# Legs (brown)
tr -0.5,0,-0.2   -0.3,0,-0.2   -0.4,-0.5,0 139,69,19
tr 0.3,0,-0.2    0.5,0,-0.2    0.4,-0.5,0 139,69,19

# Arms (dark brown)
tr -0.2,0.2,0.8 0,0.2,0.8  -0.1,0,0.8 101,67,33
tr 0.2,0.2,0.8  0.4,0.2,0.8  0.3,0,0.8 101,67,33